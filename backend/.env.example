DEBUG=True
SECRET_KEY=change-me-in-production-use-at-least-32-characters
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# P0 target database is MySQL. Set USE_SQLITE=True only for quick local demos.
USE_SQLITE=False
DB_NAME=online_edu
DB_USER=online_edu_user
DB_PASSWORD=your_password
DB_HOST=127.0.0.1
DB_PORT=3306

MEDIA_ROOT=media

# Local debug: print verification emails in the backend terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Real email sending: switch EMAIL_BACKEND to smtp and fill a real SMTP account.
# QQ Mail example: EMAIL_HOST=smtp.qq.com, EMAIL_PORT=465, EMAIL_USE_SSL=True.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_email_auth_code
DEFAULT_FROM_EMAIL=your_email@example.com
EMAIL_TIMEOUT=10
